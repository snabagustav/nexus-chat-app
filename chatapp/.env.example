# ─────────────────────────────────────────────
# NEXUS CHAT — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# JWT secret — just type any long random string (e.g. "mySecretKey12345abc")
JWT_SECRET=replace_with_any_long_random_string

# Port (leave as 3000)
PORT=3000

# Google OAuth Client ID
# Get it free at: https://console.cloud.google.com
# → APIs & Services → Credentials → Create OAuth 2.0 Client ID → Web application
# → Add http://localhost:3000 to Authorized JS origins
GOOGLE_CLIENT_ID=your_google_client_id_here

# Firebase (free — for storing users/messages)
# Go to https://console.firebase.google.com → New Project → Firestore Database
# → Project Settings → Service Accounts → Generate new private key
# Paste the values from the downloaded JSON file below:
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
